<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Dashboard Pemantauan Emosi</title>
  <link rel="stylesheet" href="https://jsdelivr.net">
</head>
<body class="bg-light p-4">
  <div class="container bg-white p-4 rounded shadow-sm">
    <h2 class="mb-4 text-center">📊 Dashboard Pemantauan Data Cerita</h2>
    <div class="mb-3">
      <a href="/" class="btn btn-primary btn-sm">⬅️ Kembali Ke Form Input</a>
    </div>

    <table class="table table-striped table-bordered align-middle">
      <thead class="table-dark">
        <tr>
          <th>No</th>
          <th>Emosi</th>
          <th>Isi Cerita</th>
          <th>Waktu Input</th>
        </tr>
      </thead>
      <tbody>
        <% if (data.length === 0) { %>
          <tr>
            <td colspan="4" class="text-center text-muted">Belum ada data cerita masuk.</td>
          </tr>
        <% } else { %>
          <% data.forEach((item, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td>
                <span class="badge <%= item.emosi === 'Kecewa' ? 'bg-danger' : 'bg-warning text-dark' %>">
                  <%= item.emosi %>
                </span>
              </td>
              <td><%= item.cerita %></td>
              <td><%= new Date(item.tanggal).toLocaleString('id-ID') %></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>
